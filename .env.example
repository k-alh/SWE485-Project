# Talea — environment template.
# Copy to apps/api/.env and fill in. Never commit a real .env.

# SQLite file used by Prisma. Relative to apps/api/prisma/
DATABASE_URL="file:./dev.db"

# API server
PORT=3000
NODE_ENV=development

# Session cookie signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-32-byte-hex-string"

# --- AI listing extraction ---------------------------------------------------
# mock        deterministic offline extractor (default, no key needed)
# openai      calls the OpenAI API; requires OPENAI_API_KEY
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Seeded accounts (development only — synthetic data)
SEED_ADMIN_EMAIL="admin@talea.test"
SEED_ADMIN_PASSWORD="admin12345"
SEED_STUDENT_EMAIL="student@talea.test"
SEED_STUDENT_PASSWORD="student12345"
